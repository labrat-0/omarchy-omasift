#!/usr/bin/env python3
"""Fetch the public marketplace catalog and reduce it to the shell's index.

The published catalog is ~5 MB of JSON. Parsing that inside the process that
also draws the desktop is not something a bar widget should do on a timer, so
the reduction happens out here and the shell only ever loads the small result.

Deliberately pure Python with no shell and no curl: the download is data, it is
never written somewhere a later command runs, and no value is ever interpolated
into a command line.

Usage: omasift-fetch [--quiet]
"""

import datetime
import json
import os
import sys
import tempfile
import urllib.error
import urllib.request

DEFAULT_URL = (
    "https://raw.githubusercontent.com/omacom/omarchy-plugin-marketplace"
    "/main/site/catalog.json"
)
# The catalog grows with every listing. Generous enough to outlive years of
# growth and still refuse a response that is not the catalog.
DEFAULT_MAX_BYTES = 32 * 1024 * 1024
TIMEOUT_SECONDS = 60


def die(message):
    sys.stderr.write("omasift-fetch: %s\n" % message)
    raise SystemExit(1)


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "omasift")


def download(url, max_bytes):
    if not url.startswith("https://"):
        die("catalog URL must be https")

    request = urllib.request.Request(url, headers={"User-Agent": "omasift"})
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
            declared = response.headers.get("Content-Length")
            if declared is not None:
                try:
                    if int(declared) > max_bytes:
                        die("catalog is larger than %d bytes" % max_bytes)
                except ValueError:
                    pass

            # Read one byte past the ceiling so an undeclared oversize response
            # is refused rather than silently truncated into invalid JSON.
            body = response.read(max_bytes + 1)
    except urllib.error.URLError as error:
        die("download failed: %s" % error)
    except OSError as error:
        die("download failed: %s" % error)

    if len(body) > max_bytes:
        die("catalog is larger than %d bytes" % max_bytes)
    if not body:
        die("downloaded catalog is empty")

    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as error:
        die("catalog is not valid JSON: %s" % error)


def text(value):
    return value if isinstance(value, str) else ""


def reduce_catalog(doc):
    plugins = doc.get("plugins")
    if not isinstance(plugins, list) or not plugins:
        die("catalog has no plugins array")

    rows = []
    for plugin in plugins:
        if not isinstance(plugin, dict):
            continue
        pid = text(plugin.get("id"))
        if not pid:
            continue

        # A single verified/unverified badge collapses two populations that
        # deserve different reactions: plugins reviewed at a commit upstream has
        # since moved past, and plugins nobody ever reviewed. The marketplace
        # separates them in verificationCoverage; carry that through rather than
        # flattening it back into a boolean.
        coverage = text(plugin.get("verificationCoverage"))
        status = text(plugin.get("verificationStatus"))
        if status == "verified":
            trust = "verified"
        elif coverage == "update-unverified":
            trust = "stale"
        elif coverage or status:
            trust = "unreviewed"
        else:
            trust = "builtin"

        repo = text(plugin.get("repo"))
        # The browser hands this to xdg-open. Anything that is not a plain web
        # URL is dropped here, so a scheme the catalog should never carry can
        # never reach a handler.
        if not repo.startswith("https://"):
            repo = ""

        rows.append({
            "id": pid,
            "name": text(plugin.get("name")) or pid,
            "desc": text(plugin.get("description")),
            "author": text(plugin.get("author")),
            "cat": text(plugin.get("category")),
            "tags": [t for t in (plugin.get("tags") or []) if isinstance(t, str)],
            "kind": text(plugin.get("kind")),
            "status": text(plugin.get("status")),
            "repo": repo,
            "ver": status,
            "trust": trust,
            "cov": coverage,
            "stars": int(plugin.get("stars") or 0),
            "license": text(plugin.get("license")),
            "install": text(plugin.get("installCommand")),
            "note": text(plugin.get("installNote")),
            "added": text(plugin.get("addedAt"))[:10],
            "updated": text(plugin.get("repositoryUpdatedAt"))[:10],
        })

    rows.sort(key=lambda row: row["name"].lower())
    now = datetime.datetime.now(datetime.timezone.utc)
    return {
        "v": 1,
        "fetchedAt": now.isoformat(timespec="seconds").replace("+00:00", "Z"),
        "generatedAt": text(doc.get("generatedAt")),
        "count": len(rows),
        "plugins": rows,
    }


def write_atomically(index, out_path):
    os.makedirs(os.path.dirname(out_path), mode=0o700, exist_ok=True)
    handle, staged = tempfile.mkstemp(
        dir=os.path.dirname(out_path), prefix=".catalog."
    )
    try:
        with os.fdopen(handle, "w") as stream:
            json.dump(index, stream, separators=(",", ":"))
            stream.write("\n")
        os.chmod(staged, 0o600)
        os.replace(staged, out_path)   # readers never see a half-written index
    except BaseException:
        os.unlink(staged)
        raise


def main(argv):
    quiet = "--quiet" in argv[1:]
    url = os.environ.get("OMASIFT_CATALOG_URL", DEFAULT_URL)
    try:
        max_bytes = int(os.environ.get("OMASIFT_MAX_BYTES", DEFAULT_MAX_BYTES))
    except ValueError:
        die("OMASIFT_MAX_BYTES must be an integer")
    if max_bytes <= 0:
        die("OMASIFT_MAX_BYTES must be positive")

    out_path = os.path.join(state_dir(), "catalog.json")

    if not quiet:
        print("Fetching %s" % url)
    index = reduce_catalog(download(url, max_bytes))
    write_atomically(index, out_path)
    if not quiet:
        print("%d plugins -> %s" % (index["count"], out_path))


if __name__ == "__main__":
    main(sys.argv)
