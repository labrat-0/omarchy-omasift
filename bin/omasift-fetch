#!/usr/bin/env python3
"""Fetch the public marketplace catalog and reduce it to the shell's index.

The published catalog is ~5 MB of JSON. Parsing that inside the process that
also draws the desktop is not something a bar widget should do on a timer, so
the reduction happens out here and the shell only ever loads the small result.

Deliberately pure Python with no shell and no curl: the download is data, it is
never written somewhere a later command runs, and no value is ever interpolated
into a command line.

Everything the network hands back is treated as hostile. The request is pinned
to one origin across every redirect, the whole operation runs under a single
monotonic deadline, every field is type-checked and length-capped before it is
kept, and the result is published through a directory descriptor that was
verified to be ours rather than through a pathname that could be swapped.

Usage: omasift-fetch [--quiet]
       omasift-fetch --read     print the cached index to stdout
"""

import datetime
import errno
import json
import math
import os
import re
import signal
import ssl
import stat
import sys
import time
import http.client
import urllib.parse

# --------------------------------------------------------------- origin policy

# The catalog lives at exactly one place. This is an allowlist rather than a
# scheme check: a URL that merely starts with "https://" can still point at an
# attacker's host, and a redirect can move it there after the first check
# passes.
CATALOG_HOST = "raw.githubusercontent.com"
CATALOG_PATH = "/omacom/omarchy-plugin-marketplace/main/site/catalog.json"
DEFAULT_URL = "https://" + CATALOG_HOST + CATALOG_PATH
ALLOWED_HOSTS = frozenset([CATALOG_HOST])
ALLOWED_PORT = 443
# OMASIFT_CATALOG_URL can move to another branch or file inside the marketplace
# repository — useful for testing against a candidate catalog — but not to some
# other repository that happens to share the host. Redirects are held to the
# origin only, since where the server moves a path within its own origin is its
# business.
CATALOG_PATH_PREFIX = "/omacom/omarchy-plugin-marketplace/"

# Repository links are handed to a desktop handler, so they get their own
# origin and path policy rather than a scheme prefix test.
REPO_HOST = "github.com"
REPO_SEGMENT = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,99}\Z")

MAX_REDIRECTS = 4
MAX_URL_LENGTH = 2048
REDIRECT_CODES = frozenset([301, 302, 303, 307, 308])
USER_AGENT = "omasift"

# ------------------------------------------------------------------- budgets

# An immutable ceiling. OMASIFT_MAX_BYTES may lower this for a constrained
# machine; it can never raise it, so the environment cannot remove the bound.
HARD_MAX_BYTES = 32 * 1024 * 1024
TOTAL_DEADLINE_SECONDS = 90      # end to end, not per socket operation
CONNECT_TIMEOUT_SECONDS = 15
READ_CHUNK = 65536
# Backstop for the whole process, in case a deadline check is never reached.
WATCHDOG_SECONDS = TOTAL_DEADLINE_SECONDS + 30
# Bounded diagnostics: the shell collects this stream into memory.
MAX_STDERR_BYTES = 4096

# --------------------------------------------------------------- schema caps

MAX_PLUGINS = 4000
MAX_TAGS = 24
MAX_OUTPUT_BYTES = 8 * 1024 * 1024
MAX_STARS = 100000000

FIELD_LIMITS = {
    "id": 200,
    "name": 200,
    "desc": 500,
    "author": 200,
    "cat": 80,
    "tag": 60,
    "kind": 80,
    "status": 80,
    "repo": 500,
    "ver": 80,
    "cov": 80,
    "license": 80,
    "install": 400,
    "note": 500,
    "date": 10,
}

TRUST_VALUES = frozenset(["verified", "stale", "unreviewed", "builtin"])
ID_PATTERN = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._:+-]{0,199}\Z")
DATE_PATTERN = re.compile(r"\A[0-9]{4}-[0-9]{2}-[0-9]{2}\Z")

# C0/C1 controls, line separators, and the bidi overrides that let a downloaded
# string reorder the text around it in the browser's list.
UNSAFE_CHARS = re.compile(
    r"[\x00-\x1f\x7f-\x9f"  # C0 and C1 controls
    r"\u200b-\u200f"        # zero-width and directional marks
    r"\u2028\u2029"         # line and paragraph separators
    r"\u202a-\u202e"        # bidi embeddings and overrides
    r"\u2066-\u2069"        # bidi isolates
    r"\ufeff]"              # zero-width no-break space
)

CACHE_NAME = "catalog.json"

# --------------------------------------------------------------- diagnostics

_stderr_budget = MAX_STDERR_BYTES


def emit(message):
    """Write one bounded diagnostic line, then stop writing entirely.

    The shell collects this stream with no cap of its own, so the cap has to
    live here.
    """
    global _stderr_budget
    if _stderr_budget <= 0:
        return
    line = "omasift-fetch: " + " ".join(str(message).split())
    if len(line) > _stderr_budget:
        line = line[: max(0, _stderr_budget - 3)] + "..."
    _stderr_budget -= len(line) + 1
    try:
        sys.stderr.write(line + "\n")
    except OSError:
        _stderr_budget = 0


def die(message):
    emit(message)
    raise SystemExit(1)


# ------------------------------------------------------------------ lifecycle


class Deadline:
    """One monotonic budget for the whole operation.

    A per-socket timeout only bounds a single read; a server that dribbles a
    byte before every timeout can hold a per-operation timeout open forever.
    """

    def __init__(self, seconds):
        self.expiry = time.monotonic() + seconds

    def remaining(self):
        return self.expiry - time.monotonic()

    def require(self, what):
        left = self.remaining()
        if left <= 0:
            die("timed out while %s" % what)
        return left

    def window(self, what, cap):
        return min(self.require(what), cap)


def install_lifecycle():
    """Bound and isolate this process before it touches the network.

    SIGALRM is a backstop that fires even if a deadline check is never reached.
    Becoming a process-group leader means a caller that wants this gone can
    take the whole group, not just this pid — but only when we are not attached
    to a terminal, since leaving the foreground group would break Ctrl-C for
    someone running this by hand.
    """
    def expired(_signum, _frame):
        die("hard timeout after %d seconds" % WATCHDOG_SECONDS)

    def terminated(signum, _frame):
        die("terminated by signal %d" % signum)

    signal.signal(signal.SIGALRM, expired)
    signal.alarm(WATCHDOG_SECONDS)
    signal.signal(signal.SIGTERM, terminated)
    signal.signal(signal.SIGINT, terminated)

    try:
        if not os.isatty(0):
            os.setpgid(0, 0)
    except OSError:
        pass


# ------------------------------------------------------------ URL validation


def validate_url(raw, what, in_repo=False):
    """Canonically parse a URL and bind it to the catalog origin.

    Returns (host, request_target, canonical_url). Any failure is fatal: this
    is called for the starting URL and again for every redirect target. Pass
    in_repo to also require the marketplace repository's path prefix.
    """
    text = str(raw)
    if len(text) > MAX_URL_LENGTH:
        die("%s is longer than %d characters" % (what, MAX_URL_LENGTH))
    if UNSAFE_CHARS.search(text):
        die("%s contains control characters" % what)

    try:
        parts = urllib.parse.urlsplit(text)
    except ValueError as error:
        die("%s will not parse: %s" % (what, error))

    if parts.scheme != "https":
        die("%s must be https" % what)
    if parts.username or parts.password:
        die("%s must not carry credentials" % what)

    host = (parts.hostname or "").lower().rstrip(".")
    if not host:
        die("%s has no host" % what)
    if host not in ALLOWED_HOSTS:
        die("%s is not on the marketplace origin (%s)" % (what, CATALOG_HOST))

    try:
        port = parts.port
    except ValueError:
        die("%s has an invalid port" % what)
    if port is not None and port != ALLOWED_PORT:
        die("%s must use port %d" % (what, ALLOWED_PORT))

    path = parts.path or "/"
    if not path.startswith("/"):
        die("%s has a relative path" % what)
    if in_repo and not path.startswith(CATALOG_PATH_PREFIX):
        die("%s is not inside the marketplace repository" % what)

    target = path + ("?" + parts.query if parts.query else "")
    canonical = urllib.parse.urlunsplit(("https", host, path, parts.query, ""))
    return host, target, canonical


# ------------------------------------------------------------------ download


def read_body(connection, response, max_bytes, deadline):
    chunks = []
    total = 0
    while total <= max_bytes:
        left = deadline.require("downloading the catalog")
        try:
            connection.sock.settimeout(min(left, CONNECT_TIMEOUT_SECONDS))
        except (AttributeError, OSError):
            pass
        want = min(READ_CHUNK, max_bytes + 1 - total)
        try:
            chunk = response.read(want)
        except (http.client.HTTPException, OSError, ssl.SSLError) as error:
            die("download failed: %s" % error)
        if not chunk:
            break
        total += len(chunk)
        chunks.append(chunk)
    if total > max_bytes:
        die("catalog is larger than %d bytes" % max_bytes)
    if total == 0:
        die("downloaded catalog is empty")
    return b"".join(chunks)


def download(url, max_bytes, deadline):
    context = ssl.create_default_context()
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED

    current = url
    hops = 0
    while True:
        host, target, canonical = validate_url(current, "catalog URL", in_repo=(hops == 0))
        connection = http.client.HTTPSConnection(
            host,
            ALLOWED_PORT,
            timeout=deadline.window("connecting", CONNECT_TIMEOUT_SECONDS),
            context=context,
        )
        try:
            try:
                connection.request(
                    "GET",
                    target,
                    headers={
                        "Host": host,
                        "User-Agent": USER_AGENT,
                        "Accept": "application/json",
                        # No transparent decompression, so the byte cap counts
                        # the same bytes the server sent.
                        "Accept-Encoding": "identity",
                        "Connection": "close",
                    },
                )
                response = connection.getresponse()
            except (http.client.HTTPException, OSError, ssl.SSLError) as error:
                die("download failed: %s" % error)

            if response.status in REDIRECT_CODES:
                hops += 1
                if hops > MAX_REDIRECTS:
                    die("too many redirects (limit %d)" % MAX_REDIRECTS)
                location = response.getheader("Location")
                if not location:
                    die("redirect with no location")
                # Resolved against the canonical current URL, then re-validated
                # at the top of the loop like any other URL.
                current = urllib.parse.urljoin(canonical, location)
                continue

            if response.status != 200:
                die("catalog request returned HTTP %d" % response.status)

            declared = response.getheader("Content-Length")
            if declared is not None:
                try:
                    if int(declared) > max_bytes:
                        die("catalog is larger than %d bytes" % max_bytes)
                except ValueError:
                    pass

            body = read_body(connection, response, max_bytes, deadline)
        finally:
            connection.close()

        deadline.require("parsing the catalog")
        try:
            return json.loads(body.decode("utf-8"))
        except (UnicodeDecodeError, ValueError) as error:
            die("catalog is not valid JSON: %s" % error)


# ---------------------------------------------------------------- validation


def clean(value, limit):
    """Bound first, then sanitise: never do per-character work on a hostile
    string before its length is capped."""
    if not isinstance(value, str):
        return ""
    return UNSAFE_CHARS.sub(" ", value[:limit]).strip()


def whole(value, limit):
    if isinstance(value, bool):
        return 0
    if isinstance(value, int):
        number = value
    elif isinstance(value, float):
        if not math.isfinite(value):
            return 0
        number = int(value)
    elif isinstance(value, str):
        try:
            number = int(value.strip()[:20])
        except ValueError:
            return 0
    else:
        return 0
    if number < 0:
        return 0
    return min(number, limit)


def clean_date(value):
    text = clean(value, FIELD_LIMITS["date"])
    return text if DATE_PATTERN.match(text) else ""


def clean_repo(value):
    """Canonicalise a repository URL, or drop it.

    The browser hands this to xdg-open, so it is held to an exact origin and an
    owner/name path shape rather than a scheme prefix.
    """
    text = clean(value, FIELD_LIMITS["repo"])
    if not text:
        return ""
    try:
        parts = urllib.parse.urlsplit(text)
    except ValueError:
        return ""
    if parts.scheme != "https" or parts.username or parts.password:
        return ""
    try:
        port = parts.port
    except ValueError:
        return ""
    if port is not None and port != 443:
        return ""
    host = (parts.hostname or "").lower().rstrip(".")
    if host == "www." + REPO_HOST:
        host = REPO_HOST
    if host != REPO_HOST or parts.query or parts.fragment:
        return ""

    segments = [s for s in parts.path.split("/") if s]
    if len(segments) != 2:
        return ""
    owner, repo = segments
    if repo.endswith(".git"):
        repo = repo[:-4]
    if not REPO_SEGMENT.match(owner) or not REPO_SEGMENT.match(repo):
        return ""
    return "https://%s/%s/%s" % (REPO_HOST, owner, repo)


def validate_row(row):
    """Type, bound, and enum-check one reduced row.

    Runs on rows built from a fresh download and again on rows read back out of
    the cache, so a tampered cache file is held to the same shape as the wire.
    """
    if not isinstance(row, dict):
        return None

    raw_id = row.get("id")
    # Length is checked before the cap is applied, not after: truncating an
    # over-long id would let two distinct listings collapse onto one identity.
    if not isinstance(raw_id, str) or len(raw_id) > FIELD_LIMITS["id"]:
        return None
    pid = clean(raw_id, FIELD_LIMITS["id"])
    if not ID_PATTERN.match(pid):
        return None

    trust = row.get("trust")
    if trust not in TRUST_VALUES:
        trust = "unreviewed"

    raw_tags = row.get("tags")
    tags = []
    if isinstance(raw_tags, list):
        for tag in raw_tags[:MAX_TAGS]:
            text = clean(tag, FIELD_LIMITS["tag"])
            if text:
                tags.append(text)

    return {
        "id": pid,
        "name": clean(row.get("name"), FIELD_LIMITS["name"]) or pid,
        "desc": clean(row.get("desc"), FIELD_LIMITS["desc"]),
        "author": clean(row.get("author"), FIELD_LIMITS["author"]),
        "cat": clean(row.get("cat"), FIELD_LIMITS["cat"]),
        "tags": tags,
        "kind": clean(row.get("kind"), FIELD_LIMITS["kind"]),
        "status": clean(row.get("status"), FIELD_LIMITS["status"]),
        "repo": clean_repo(row.get("repo")),
        "ver": clean(row.get("ver"), FIELD_LIMITS["ver"]),
        "trust": trust,
        "cov": clean(row.get("cov"), FIELD_LIMITS["cov"]),
        "stars": whole(row.get("stars"), MAX_STARS),
        "license": clean(row.get("license"), FIELD_LIMITS["license"]),
        "install": clean(row.get("install"), FIELD_LIMITS["install"]),
        "note": clean(row.get("note"), FIELD_LIMITS["note"]),
        "added": clean_date(row.get("added")),
        "updated": clean_date(row.get("updated")),
    }


def fit(rows):
    """Keep the leading rows that fit inside the output byte budget.

    Per-field caps alone do not bound the document: a catalog with enough
    listings still exceeds any sane size, so the serialised total is the last
    word.
    """
    budget = MAX_OUTPUT_BYTES
    kept = []
    used = 0
    for row in rows:
        size = len(json.dumps(row, separators=(",", ":")).encode("utf-8")) + 1
        if used + size > budget:
            break
        used += size
        kept.append(row)
    return kept


def reduce_catalog(doc):
    if not isinstance(doc, dict):
        die("catalog is not a JSON object")
    plugins = doc.get("plugins")
    if not isinstance(plugins, list) or not plugins:
        die("catalog has no plugins array")

    rows = []
    seen = set()
    duplicates = 0
    for plugin in plugins[:MAX_PLUGINS]:
        if not isinstance(plugin, dict):
            continue

        # A single verified/unverified badge collapses two populations that
        # deserve different reactions: plugins reviewed at a commit upstream has
        # since moved past, and plugins nobody ever reviewed. The marketplace
        # separates them in verificationCoverage; carry that through rather than
        # flattening it back into a boolean.
        coverage = clean(plugin.get("verificationCoverage"), FIELD_LIMITS["cov"])
        status = clean(plugin.get("verificationStatus"), FIELD_LIMITS["ver"])
        if status == "verified":
            trust = "verified"
        elif coverage == "update-unverified":
            trust = "stale"
        elif coverage or status:
            trust = "unreviewed"
        else:
            trust = "builtin"

        row = validate_row({
            "id": plugin.get("id"),
            "name": plugin.get("name"),
            "desc": plugin.get("description"),
            "author": plugin.get("author"),
            "cat": plugin.get("category"),
            "tags": plugin.get("tags"),
            "kind": plugin.get("kind"),
            "status": plugin.get("status"),
            "repo": plugin.get("repo"),
            "ver": status,
            "trust": trust,
            "cov": coverage,
            "stars": plugin.get("stars"),
            "license": plugin.get("license"),
            "install": plugin.get("installCommand"),
            "note": plugin.get("installNote"),
            "added": plugin.get("addedAt"),
            "updated": plugin.get("repositoryUpdatedAt"),
        })
        if row is None:
            continue
        # First listing for an id wins. Later ones would otherwise let a
        # duplicate entry shadow a real plugin's trust badge.
        if row["id"] in seen:
            duplicates += 1
            continue
        seen.add(row["id"])
        rows.append(row)

    if not rows:
        die("catalog has no usable listings")

    rows.sort(key=lambda row: row["name"].lower())
    kept = fit(rows)
    now = datetime.datetime.now(datetime.timezone.utc)
    return {
        "v": 1,
        "fetchedAt": now.isoformat(timespec="seconds").replace("+00:00", "Z"),
        "generatedAt": clean_date(str(doc.get("generatedAt"))[:10]),
        "count": len(kept),
        "dropped": len(rows) - len(kept) + duplicates,
        "plugins": kept,
    }


def validate_index(raw):
    """Re-validate a document read back out of the cache."""
    try:
        doc = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as error:
        die("cached catalog is not valid JSON: %s" % error)
    if not isinstance(doc, dict) or doc.get("v") != 1:
        die("cached catalog is not a version 1 index")
    plugins = doc.get("plugins")
    if not isinstance(plugins, list):
        die("cached catalog has no plugins array")

    rows = []
    seen = set()
    for row in plugins[:MAX_PLUGINS]:
        checked = validate_row(row)
        if checked is None or checked["id"] in seen:
            continue
        seen.add(checked["id"])
        rows.append(checked)

    kept = fit(rows)
    return {
        "v": 1,
        "fetchedAt": clean(doc.get("fetchedAt"), 32),
        "generatedAt": clean_date(doc.get("generatedAt")),
        "count": len(kept),
        "dropped": whole(doc.get("dropped"), MAX_PLUGINS) + len(rows) - len(kept),
        "plugins": kept,
    }


# ------------------------------------------------------------------ cache I/O


def open_state_dir():
    """Walk to the state directory component by component, holding a verified
    descriptor at the end.

    Every component is opened O_NOFOLLOW so a symlink anywhere in the chain is a
    refusal rather than a redirect, and the descriptor — not the pathname — is
    what the write and the read go through afterwards, so nothing can be swapped
    underneath between the check and the use.
    """
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    target = os.path.join(base, "omasift")
    if not os.path.isabs(target):
        die("state directory must be an absolute path")

    uid = os.getuid()
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open("/", flags)
    walked = ""
    try:
        for name in [part for part in target.split("/") if part]:
            if name in (".", ".."):
                die("state directory path must be canonical")
            walked += "/" + name
            try:
                os.mkdir(name, 0o700, dir_fd=fd)
            except FileExistsError:
                pass
            except OSError as error:
                die("cannot create %s: %s" % (walked, error.strerror))

            try:
                child = os.open(name, flags, dir_fd=fd)
            except OSError as error:
                # O_DIRECTORY|O_NOFOLLOW reports ENOTDIR rather than ELOOP for a
                # symlink on Linux, so ask what the component really is instead
                # of inferring it from errno.
                if error.errno in (errno.ELOOP, errno.EMLINK, errno.ENOTDIR):
                    try:
                        kind = os.lstat(name, dir_fd=fd).st_mode
                    except OSError:
                        kind = 0
                    if stat.S_ISLNK(kind):
                        die("%s is a symlink; refusing to write through it" % walked)
                    die("%s is not a directory" % walked)
                die("cannot open %s: %s" % (walked, error.strerror))

            info = os.fstat(child)
            if not stat.S_ISDIR(info.st_mode):
                os.close(child)
                die("%s is not a directory" % walked)
            if info.st_uid not in (uid, 0):
                os.close(child)
                die("%s is owned by uid %d" % (walked, info.st_uid))
            os.close(fd)
            fd = child

        info = os.fstat(fd)
        if info.st_uid != uid:
            die("%s is not owned by you" % target)
        if info.st_mode & 0o077:
            try:
                os.fchmod(fd, 0o700)
            except OSError:
                die("%s is group or world accessible" % target)
    except BaseException:
        os.close(fd)
        raise
    return fd, target


def publish(payload, dir_fd):
    """Write and rename entirely through the verified directory descriptor."""
    staged = ".catalog.%d.tmp" % os.getpid()
    try:
        os.unlink(staged, dir_fd=dir_fd)
    except FileNotFoundError:
        pass
    except OSError as error:
        die("cannot clear a stale staging file: %s" % error.strerror)

    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        fd = os.open(staged, flags, 0o600, dir_fd=dir_fd)
    except OSError as error:
        die("cannot stage the catalog: %s" % error.strerror)

    try:
        view = memoryview(payload.encode("utf-8"))
        while view:
            # os.write is free to accept a partial buffer; a short write that
            # went unnoticed would publish a truncated index.
            view = view[os.write(fd, view):]
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        try:
            os.unlink(staged, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    os.close(fd)

    try:
        os.replace(staged, CACHE_NAME, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        os.fsync(dir_fd)      # the rename itself has to reach the disk
    except OSError as error:
        try:
            os.unlink(staged, dir_fd=dir_fd)
        except OSError:
            pass
        die("cannot publish the catalog: %s" % error.strerror)


def read_cache(dir_fd):
    """Bounded, no-follow read of the published index.

    Returns None when nothing has been fetched yet. The shell calls this rather
    than opening the file by pathname itself.
    """
    # O_NONBLOCK so a fifo parked at the cache path is refused by the type check
    # below instead of blocking the open until the watchdog fires. It is a no-op
    # once the descriptor turns out to be the regular file we require.
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        fd = os.open(CACHE_NAME, flags, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError as error:
        if error.errno in (errno.ELOOP, errno.EMLINK):
            die("cached catalog is a symlink; refusing to read it")
        die("cannot open the cached catalog: %s" % error.strerror)

    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            die("cached catalog is not a regular file")
        if info.st_uid != os.getuid():
            die("cached catalog is not owned by you")
        if info.st_size > MAX_OUTPUT_BYTES:
            die("cached catalog is larger than %d bytes" % MAX_OUTPUT_BYTES)

        chunks = []
        total = 0
        while total <= MAX_OUTPUT_BYTES:
            chunk = os.read(fd, READ_CHUNK)
            if not chunk:
                break
            total += len(chunk)
            chunks.append(chunk)
        if total > MAX_OUTPUT_BYTES:
            die("cached catalog is larger than %d bytes" % MAX_OUTPUT_BYTES)
    finally:
        os.close(fd)
    return b"".join(chunks)


# ----------------------------------------------------------------------- main


def max_bytes_from_env():
    raw = os.environ.get("OMASIFT_MAX_BYTES")
    if raw is None:
        return HARD_MAX_BYTES
    try:
        value = int(raw.strip()[:20])
    except ValueError:
        die("OMASIFT_MAX_BYTES must be an integer")
    if value <= 0:
        die("OMASIFT_MAX_BYTES must be positive")
    # Clamped, never trusted upward.
    return min(value, HARD_MAX_BYTES)


def main(argv):
    args = argv[1:]
    for arg in args:
        if arg not in ("--quiet", "--read"):
            die("unknown argument")
    quiet = "--quiet" in args
    reading = "--read" in args

    install_lifecycle()
    dir_fd, state_path = open_state_dir()
    try:
        if reading:
            raw = read_cache(dir_fd)
            if raw is None:
                die("no catalog has been fetched yet")
            sys.stdout.write(json.dumps(validate_index(raw), separators=(",", ":")))
            return

        deadline = Deadline(TOTAL_DEADLINE_SECONDS)
        url = os.environ.get("OMASIFT_CATALOG_URL", DEFAULT_URL)
        if not quiet:
            print("Fetching %s" % validate_url(url, "catalog URL", in_repo=True)[2])
        index = reduce_catalog(download(url, max_bytes_from_env(), deadline))
        publish(json.dumps(index, separators=(",", ":")) + "\n", dir_fd)
        if not quiet:
            print("%d plugins -> %s/%s" % (index["count"], state_path, CACHE_NAME))
    finally:
        os.close(dir_fd)


if __name__ == "__main__":
    try:
        main(sys.argv)
        sys.stdout.flush()
    except BrokenPipeError:
        # A reader that walked away (`| head`) is not worth a traceback. Point
        # stdout at the void so the interpreter's own flush at exit stays quiet.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        raise SystemExit(1)
