#!/bin/bash

# What OmaSift needs, and whether it is here. Prints a line per check and
# exits non-zero if anything required is missing.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omasift"
CATALOG="$STATE_DIR/catalog.json"
FAIL=0

ok()   { echo "  ok    $*"; }
warn() { echo "  warn  $*"; }
bad()  { echo "  FAIL  $*"; FAIL=1; }

echo "OmaSift doctor"

for cmd in curl python3 wl-copy; do
  if command -v "$cmd" >/dev/null 2>&1; then ok "$cmd"
  else bad "$cmd is missing"; fi
done

if command -v xdg-open >/dev/null 2>&1; then ok "xdg-open"
else warn "xdg-open is missing — 'open repo' will do nothing"; fi

if [[ -f $CATALOG ]]; then
  count=$(python3 -c "import json,sys; print(json.load(open('$CATALOG'))['count'])" 2>/dev/null)
  when=$(python3 -c "import json,sys; print(json.load(open('$CATALOG'))['fetchedAt'])" 2>/dev/null)
  if [[ -n $count ]]; then ok "catalog: $count listings, fetched $when"
  else bad "catalog exists but will not parse: $CATALOG"; fi
else
  warn "no catalog yet — run: $(dirname "$0")/omasift-fetch"
fi

if command -v omarchy-shell >/dev/null 2>&1; then
  if omarchy-shell shell ping >/dev/null 2>&1; then ok "omarchy-shell responds"
  else warn "omarchy-shell is not answering"; fi
else
  bad "omarchy-shell is missing"
fi

exit $FAIL
